{
  "name": "bedrock-contract-analyzer",
  "version": "0.1.0",
  "description": "Internal tool for Bedrock Concrete Cutting to analyze incoming subcontracts: tiered triage, a construction-specific clause-flagging engine, and the three deliverables (written report, risk-rated table, phased checklist) plus GC-response email variants.",
  "type": "module",
  "bin": {
    "bedrock-analyze": "src/cli.js"
  },
  "scripts": {
    "analyze": "node src/cli.js",
    "build:web": "node scripts/build-web.mjs",
    "web": "node scripts/build-web.mjs && node web/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@napi-rs/canvas": "^1.0.1",
    "commander": "^12.1.0",
    "docx": "^9.0.2",
    "express": "^4.21.0",
    "google-auth-library": "^10.9.0",
    "jose": "^6.2.3",
    "multer": "^2.0.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "tesseract.js": "^6.0.1",
    "zod": "^4.4.3"
  },
  "license": "UNLICENSED",
  "private": true
}
